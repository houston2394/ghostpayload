---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, projects } from '../data/site';
import { getCollection } from 'astro:content';

const featured = projects.filter((p) => p.featured);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base active="home">
  <section class="hero">
    <p class="eyebrow">{site.tagline}</p>
    <h1 class="hero-title">
      Signals in, <span class="accent">clarity</span> out.
    </h1>
    <p class="hero-intro">{site.intro}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/projects">View projects</a>
      <a class="btn" href="/blog">Read the journal</a>
    </div>
    <p class="hero-whoami">
      <span class="muted">$</span> whoami &nbsp;&rarr;&nbsp;
      <span class="accent">{site.author}</span>, building
      <a href={site.links.github} target="_blank" rel="noopener">@{site.handle}</a>
    </p>
  </section>

  <section class="block">
    <div class="block-head">
      <h2 class="block-title">Featured work</h2>
      <a class="block-more" href="/projects">all projects →</a>
    </div>
    <div class="project-grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="block">
        <div class="block-head">
          <h2 class="block-title">From the journal</h2>
          <a class="block-more" href="/blog">
            all posts →
          </a>
        </div>
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-row">
              <a href={`/blog/${post.id}/`} class="post-link">
                <span class="post-date">{fmt(post.data.pubDate)}</span>
                <span class="post-title">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding: 36px 0 20px;
  }
  .hero-title {
    font-size: clamp(2.1rem, 6vw, 3.1rem);
    margin: 0 0 18px;
    letter-spacing: -0.03em;
  }
  .hero-intro {
    font-size: 1.12rem;
    color: var(--text-dim);
    max-width: 62ch;
    margin: 0 0 26px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .btn {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 9px 18px;
    border-radius: 8px;
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--bg-soft);
    transition: all 0.16s ease;
  }
  .btn:hover {
    border-color: var(--accent-dim);
    color: var(--text);
    transform: translateY(-1px);
  }
  .btn-primary {
    background: var(--accent);
    color: #04140d;
    border-color: var(--accent);
    font-weight: 600;
  }
  .btn-primary:hover {
    background: var(--cyan);
    border-color: var(--cyan);
    color: #04140d;
  }
  .hero-whoami {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--text-dim);
    border-top: 1px dashed var(--border);
    padding-top: 20px;
    margin: 8px 0 0;
  }

  .block {
    margin-top: 56px;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  .block-title {
    font-size: 1.35rem;
    margin: 0;
  }
  .block-title::before {
    content: '# ';
    color: var(--accent-dim);
    font-family: var(--font-mono);
  }
  .block-more {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  .block-more:hover {
    color: var(--accent);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 16px;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-row + .post-row {
    border-top: 1px solid var(--border-soft);
  }
  .post-link {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 14px 4px;
    color: var(--text);
  }
  .post-link:hover {
    color: var(--accent);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    flex-shrink: 0;
    width: 110px;
  }
  .post-title {
    font-size: 1rem;
  }
  @media (max-width: 520px) {
    .post-link {
      flex-direction: column;
      gap: 3px;
    }
    .post-date {
      width: auto;
    }
  }
</style>
