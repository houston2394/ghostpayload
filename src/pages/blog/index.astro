---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<Base active="blog" title="Blog" description="Field notes from building at the edge of security and AI.">
  <header class="page-head">
    <p class="eyebrow">Journal</p>
    <h1>Field notes</h1>
    <p class="page-sub">
      Documenting the build — what I’m learning, breaking, and shipping along the way.
    </p>
  </header>

  {
    posts.length === 0 ? (
      <p class="empty">No posts yet. First entry incoming.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a href={`/blog/${post.id}/`} class="post-card">
              <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                {fmt(post.data.pubDate)}
              </time>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  .page-head {
    padding: 28px 0 34px;
  }
  .page-head h1 {
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }
  .page-sub {
    color: var(--text-dim);
    max-width: 58ch;
    margin: 0;
  }
  .empty {
    color: var(--text-dim);
    font-family: var(--font-mono);
  }
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .post-card {
    display: block;
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px 22px;
    background: linear-gradient(180deg, var(--panel), var(--bg-soft));
    transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .post-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }
  .post-date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .post-title {
    font-size: 1.25rem;
    margin: 6px 0 8px;
  }
  .post-card:hover .post-title {
    color: var(--accent);
  }
  .post-desc {
    margin: 0 0 14px;
    color: var(--text-dim);
    font-size: 0.95rem;
  }
  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
</style>
