---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base active="blog" title={post.data.title} description={post.data.description}>
  <article class="post">
    <a href="/blog" class="back">← back to journal</a>
    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <span class="muted">· updated {fmt(post.data.updatedDate)}</span>
          )
        }
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-desc">{post.data.description}</p>
      {
        post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post {
    padding: 24px 0 20px;
  }
  .back {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-dim);
  }
  .back:hover {
    color: var(--accent);
  }
  .post-header {
    margin: 22px 0 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border-soft);
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .post-header h1 {
    font-size: clamp(1.8rem, 5vw, 2.5rem);
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }
  .post-desc {
    color: var(--text-dim);
    font-size: 1.08rem;
    margin: 0 0 16px;
  }
  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
</style>
