---
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}

const { title, description, active } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const pageDesc = description ?? site.intro;

const nav = [
  { label: 'home', href: '/' },
  { label: 'projects', href: '/projects' },
  { label: 'blog', href: '/blog' },
  { label: 'about', href: '/about' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <meta name="author" content={site.author} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={site.url} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <div class="scanline" aria-hidden="true"></div>
    <header class="site-header">
      <a href="/" class="brand">
        <span class="brand-mark">▞</span>
        <span class="brand-name">{site.name}</span>
      </a>
      <nav class="site-nav">
        {
          nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { current: active === item.label }]}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <span class="footer-prompt">
          <span class="muted">{site.handle}@ghostpayload</span>:<span class="accent">~</span>$
          <span class="cursor">_</span>
        </span>
        <nav class="footer-links">
          <a href={site.links.github} rel="me noopener" target="_blank">github</a>
          <a href={`mailto:${site.email}`}>email</a>
          <a href="/rss.xml">rss</a>
        </nav>
      </div>
      <p class="footer-meta">© {new Date().getFullYear()} {site.author} · built with Astro</p>
    </footer>

    <style is:global>
      :root {
        --bg: #07090d;
        --bg-soft: #0c1016;
        --panel: #0f141b;
        --border: #1d2733;
        --border-soft: #161d26;
        --text: #cdd6e0;
        --text-dim: #8591a0;
        --muted: #5a6675;
        --accent: #39e0a0;
        --accent-dim: #1f8f66;
        --cyan: #4fd0e3;
        --warn: #e8b84b;
        --font-mono: 'SFMono-Regular', ui-monospace, 'JetBrains Mono', 'Cascadia Code',
          Menlo, Consolas, monospace;
        --font-sans: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        --maxw: 820px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        background:
          radial-gradient(1200px 600px at 80% -10%, rgba(57, 224, 160, 0.06), transparent 60%),
          radial-gradient(900px 500px at 0% 0%, rgba(79, 208, 227, 0.05), transparent 55%),
          var(--bg);
        color: var(--text);
        font-family: var(--font-sans);
        line-height: 1.65;
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image: linear-gradient(var(--border-soft) 1px, transparent 1px),
          linear-gradient(90deg, var(--border-soft) 1px, transparent 1px);
        background-size: 44px 44px;
        opacity: 0.25;
        pointer-events: none;
        z-index: 0;
        mask-image: radial-gradient(ellipse 100% 70% at 50% 0%, #000 40%, transparent 100%);
      }

      .scanline {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        background: repeating-linear-gradient(
          to bottom,
          rgba(255, 255, 255, 0.015) 0px,
          rgba(255, 255, 255, 0.015) 1px,
          transparent 1px,
          transparent 3px
        );
        mix-blend-mode: overlay;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.15s ease;
      }
      a:hover {
        color: var(--cyan);
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
        font-weight: 650;
        letter-spacing: -0.01em;
        color: #e8eef5;
      }

      .accent {
        color: var(--accent);
      }
      .muted {
        color: var(--muted);
      }

      /* ---------- layout ---------- */
      .site-header,
      .site-main,
      .site-footer {
        position: relative;
        z-index: 2;
        width: 100%;
        max-width: var(--maxw);
        margin: 0 auto;
        padding-left: 24px;
        padding-right: 24px;
      }

      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 26px;
        padding-bottom: 26px;
        gap: 16px;
        flex-wrap: wrap;
      }

      .brand {
        display: inline-flex;
        align-items: baseline;
        gap: 9px;
        font-family: var(--font-mono);
        font-weight: 600;
        color: var(--text);
      }
      .brand:hover {
        color: var(--text);
      }
      .brand-mark {
        color: var(--accent);
        font-size: 1.1rem;
      }
      .brand-name {
        letter-spacing: -0.02em;
      }

      .site-nav {
        display: flex;
        gap: 4px;
        font-family: var(--font-mono);
        font-size: 0.9rem;
        flex-wrap: wrap;
      }
      .nav-link {
        color: var(--text-dim);
        padding: 5px 10px;
        border-radius: 6px;
        border: 1px solid transparent;
      }
      .nav-link::before {
        content: '/';
        color: var(--muted);
        margin-right: 1px;
      }
      .nav-link:hover {
        color: var(--text);
        background: var(--bg-soft);
      }
      .nav-link.current {
        color: var(--accent);
        border-color: var(--border);
        background: var(--bg-soft);
      }

      .site-main {
        flex: 1 0 auto;
        padding-top: 18px;
        padding-bottom: 80px;
      }

      .site-footer {
        flex-shrink: 0;
        border-top: 1px solid var(--border-soft);
        padding-top: 22px;
        padding-bottom: 40px;
        margin-top: 40px;
      }
      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        font-family: var(--font-mono);
        font-size: 0.88rem;
      }
      .footer-links {
        display: flex;
        gap: 18px;
      }
      .footer-links a {
        color: var(--text-dim);
      }
      .footer-links a:hover {
        color: var(--accent);
      }
      .footer-meta {
        color: var(--muted);
        font-size: 0.8rem;
        margin: 14px 0 0;
      }
      .cursor {
        animation: blink 1.1s steps(1) infinite;
        color: var(--accent);
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      /* ---------- reusable bits ---------- */
      .eyebrow {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent-dim);
        margin: 0 0 10px;
      }

      .tag {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--text-dim);
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 2px 9px;
        background: rgba(255, 255, 255, 0.015);
      }

      .prose {
        font-size: 1.02rem;
      }
      .prose p,
      .prose ul,
      .prose ol {
        margin: 0 0 1.1em;
      }
      .prose h2 {
        margin: 1.9em 0 0.6em;
        font-size: 1.4rem;
      }
      .prose h3 {
        margin: 1.5em 0 0.5em;
        font-size: 1.15rem;
      }
      .prose a {
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--accent-dim);
      }
      .prose code {
        font-family: var(--font-mono);
        font-size: 0.86em;
        background: var(--bg-soft);
        border: 1px solid var(--border-soft);
        border-radius: 5px;
        padding: 1px 6px;
      }
      .prose pre {
        background: var(--bg-soft) !important;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 16px 18px;
        overflow-x: auto;
        font-size: 0.86rem;
        line-height: 1.5;
      }
      .prose pre code {
        background: none;
        border: 0;
        padding: 0;
      }
      .prose blockquote {
        border-left: 2px solid var(--accent-dim);
        margin: 1.2em 0;
        padding: 2px 0 2px 18px;
        color: var(--text-dim);
      }
      .prose img {
        max-width: 100%;
        border-radius: 10px;
        border: 1px solid var(--border);
      }
      .prose hr {
        border: 0;
        border-top: 1px solid var(--border-soft);
        margin: 2em 0;
      }

      @media (max-width: 560px) {
        .site-header {
          padding-top: 20px;
        }
        body {
          font-size: 15px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .cursor {
          animation: none;
        }
        html {
          scroll-behavior: auto;
        }
      }
    </style>
  </body>
</html>
